#Include %A_LineFile%\..\I18n.ahk
;=====================================================================
; ECDICT offline dictionary lookup (#Included by Translator.ahk)
; Generated by tools/build_dict.py: dict\ecdict.dat (sorted by lowercase key) + dict\ecdict.idx (uint32 offsets)
; Lookup = binary search over idx, reading one line at a time; the dictionary is not loaded into memory, and a single lookup takes < 1ms.
;=====================================================================

; Locates the dictionary relative to this file's directory (shared by the main program and test scripts)
DictDir() {
    local dir := AppDir()
    return dir . "\dict"
}
DictDat() => DictDir() . "\ecdict.dat"
DictIdx() => DictDir() . "\ecdict.idx"

DictAvailable() => FileExist(DictDat()) && FileExist(DictIdx())

DictCount() {
    try
        return FileGetSize(DictIdx()) // 4
    return 0
}

; Whether the selection looks like a word or phrase (up to 4 words); only then is the dictionary used
IsWordLike(s) {
    return StrLen(s) <= 40
        && RegExMatch(s, "^[A-Za-z][A-Za-z'\-]*( [A-Za-z][A-Za-z'\-]*){0,3}$")
}

; Strips punctuation and quotes from both ends of the selection (double-click selection often includes commas and periods)
DictCleanWord(s) {
    s := Trim(s)
    s := RegExReplace(s, "^[`"'“”‘’(\[{<]+|[`"'“”‘’)\]}>.,;:!?]+$")
    return RegExReplace(s, "\s+", " ")
}

; Lookup: returns Map(word, phonetic, lines[], exchange, lemma), or 0
; On a miss, tries simple lemmatization in turn: 's, plural, past tense, present participle, etc.
DictLookup(word) {
    if !DictAvailable()
        return 0
    local e := DictFind(word)
    if (e)
        return e
    ; Possessive 's is simply removed
    if RegExMatch(word, "^(.+)'s$", &m) && (e := DictFind(m[1]))
        return e
    ; A candidate base form must list this word among its own inflections, to avoid mapping to obscure dictionary entries (e.g. boxes → boxe)
    local w := StrLower(word)
    for cand in DictStemCandidates(w) {
        e := DictFind(cand)
        if (e && RegExMatch(e["exchange"], "i)(^|/)[^:/]+:\Q" w "\E(/|$)"))
            return e
    }
    return 0
}

DictStemCandidates(w) {
    local out := []
    if RegExMatch(w, "^(.+)ies$", &m)
        out.Push(m[1] . "y")
    if RegExMatch(w, "^(.+)es$", &m)
        out.Push(m[1])
    if RegExMatch(w, "^(.+)s$", &m)
        out.Push(m[1])
    if RegExMatch(w, "^(.+)ied$", &m)
        out.Push(m[1] . "y")
    if RegExMatch(w, "^(.+)ed$", &m)
        out.Push(m[1], m[1] . "e")
    if RegExMatch(w, "^(.+)ing$", &m)
        out.Push(m[1], m[1] . "e")
    return out
}

; Exact key lookup (lowercase); if several entries share the key, prefer the one whose casing matches exactly
DictFind(word) {
    local key := StrLower(word)
    local idx := FileOpen(DictIdx(), "r")
    local dat := FileOpen(DictDat(), "r", "UTF-8-RAW")
    if (!idx || !dat)
        return 0
    local n := idx.Length // 4
    local lo := 0, hi := n
    while (lo < hi) {
        local mid := (lo + hi) // 2
        if (StrCompare(DictKeyOf(DictLineAt(idx, dat, mid)), key, true) < 0)
            lo := mid + 1
        else
            hi := mid
    }
    local best := ""
    while (lo < n) {
        local line := DictLineAt(idx, dat, lo)
        if (DictKeyOf(line) !== key)
            break
        local f := StrSplit(line, "`t")
        if (best = "" || f[2] == word)
            best := line
        lo += 1
    }
    idx.Close(), dat.Close()
    return (best = "") ? 0 : DictParse(best)
}

DictLineAt(idx, dat, i) {
    idx.Pos := i * 4
    dat.Pos := idx.ReadUInt()
    return RTrim(dat.ReadLine(), "`r`n")
}

DictKeyOf(line) {
    local p := InStr(line, "`t")
    return p ? SubStr(line, 1, p - 1) : line
}

; One line -> Map; each item in lines is Map(kind, tag, text)
;   kind = "pos" (parts of speech such as n./vt./adj.) | "domain" (field labels such as [医]/[计]/[网络], i.e. medicine/computing/networking) | "plain" (unlabeled)
DictParse(line) {
    local f := StrSplit(line, "`t")
    while (f.Length < 5)
        f.Push("")
    local e := Map("word", f[2], "phonetic", f[3], "exchange", f[5], "lines", [], "lemma", "")
    for raw in StrSplit(f[4], "\n") {
        raw := Trim(raw)
        if (raw = "")
            continue
        if RegExMatch(raw, "^([a-z]+\.) (.*)$", &m)
            e["lines"].Push(Map("kind", "pos", "tag", m[1], "text", m[2]))
        else if RegExMatch(raw, "^\[([^\]]+)\]\s*(.*)$", &m)
            e["lines"].Push(Map("kind", "domain", "tag", "[" m[1] "]", "text", m[2]))
        else
            e["lines"].Push(Map("kind", "plain", "tag", "", "text", raw))
    }
    if RegExMatch(e["exchange"], "(?:^|/)0:([^/]+)", &m)
        e["lemma"] := m[1]
    return e
}

; Filters the senses to display according to settings:
;   When show_domain=0, field senses such as [医][计] are hidden, but if the entry has no part-of-speech sense at all, all senses are kept (so specialist terms do not show as empty)
DictSenses(e, showDomain, maxSenses) {
    local hasPos := false
    for ln in e["lines"]
        if (ln["kind"] = "pos") {
            hasPos := true
            break
        }
    local out := []
    for ln in e["lines"] {
        if (ln["kind"] = "domain" && !showDomain && hasPos)
            continue
        out.Push(ln)
        if (maxSenses > 0 && out.Length >= maxSenses)
            break
    }
    return out
}

; exchange field -> "plural apples · past tense ran …"
DictForms(exchange) {
    static names := Map("p", "dict.form.p", "d", "dict.form.d", "i", "dict.form.i", "3", "dict.form.3",
        "r", "dict.form.r", "t", "dict.form.t", "s", "dict.form.s")
    static order := ["s", "p", "d", "i", "3", "r", "t"]
    local got := Map()
    for part in StrSplit(exchange, "/") {
        local kv := StrSplit(part, ":", , 2)
        if (kv.Length = 2 && names.Has(kv[1]))
            got[kv[1]] := kv[2]
    }
    local out := ""
    for k in order
        if got.Has(k)
            out .= (out = "" ? "" : "  ·  ") . Tr(names[k]) . " " . got[k]
    return out
}
